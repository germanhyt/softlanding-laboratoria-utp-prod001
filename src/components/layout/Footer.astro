---
import { siteConfig } from "@/config/site.config";
import { navContent } from "@/data/content";
---

<footer class="w-full bg-primary">
  <div
    class="mx-auto flex w-full max-w-[1440px] flex-col items-start justify-between gap-6 px-4 py-8 sm:flex-row sm:items-center md:px-10 md:py-9"
  >
    <a href="/" class="inline-flex items-center" aria-label={siteConfig.brand}>
      <img
        src="/assets/logos/logo-black.png"
        alt={siteConfig.brand}
        class="h-7 w-auto md:h-8"
        width="180"
        height="32"
      />
    </a>
    <a
      href={siteConfig.links.conoceNos}
      class="text-base text-text transition-opacity hover:opacity-70"
      target="_blank"
      rel="noopener noreferrer"
    >
      {navContent.conoceNos}
    </a>
  </div>
</footer>
