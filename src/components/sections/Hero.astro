---
import { siteConfig } from "@/config/site.config";
import { heroAssets, heroContent } from "@/data/content";
import HeroSection from "@/components/react/HeroSection";
---

<HeroSection
  client:load
  title={heroContent.title}
  description={heroContent.description}
  cta={heroContent.cta}
  ctaHref={siteConfig.links.postular}
  tagline={heroContent.tagline}
  brand={siteConfig.brand}
  partner={siteConfig.partner}
  imageDesktop={heroContent.imageDesktop}
  imageMobile={heroContent.imageMobile}
  logoWhite={heroAssets.logoWhite}
  logoUtp={heroAssets.logoUtp}
/>
