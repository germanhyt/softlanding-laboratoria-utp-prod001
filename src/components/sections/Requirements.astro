---
import { siteConfig } from "@/config/site.config";
import { requirementsContent } from "@/data/content";
import RequirementsSection from "@/components/react/RequirementsSection";
---

<RequirementsSection
  client:visible
  title={requirementsContent.title}
  cta={requirementsContent.cta}
  ctaHref={siteConfig.links.postular}
  image={requirementsContent.image}
  imageAlt={requirementsContent.imageAlt}
  arrows={requirementsContent.arrows}
  cards={requirementsContent.cards}
/>
