---
import { skillsContent } from "@/data/content";
---

<section class="bg-primary py-14 md:py-20" aria-labelledby="skills-title">
  <div class="mx-auto w-full max-w-[1440px] px-4 md:px-10">
    <div class="mx-auto mb-10 max-w-[820px] text-center md:mb-14">
      <h2 id="skills-title" class="section-title">
        {skillsContent.title}
      </h2>
      <p class="section-body mt-4 text-text-soft">
        {skillsContent.subtitle}
      </p>
    </div>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
      {
        skillsContent.cards.map((card) => (
          <article class="flex h-full flex-col rounded-[20px] bg-white p-5 md:p-6">
            <img
              src={card.image}
              alt=""
              class="mb-4 h-[140px] w-full object-contain md:h-[160px]"
              loading="lazy"
            />
            <h3 class="mb-2 text-lg font-semibold leading-snug md:text-xl">{card.title}</h3>
            <p class="text-sm leading-relaxed text-text-muted md:text-base">{card.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
