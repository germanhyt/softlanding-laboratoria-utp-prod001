---
import { siteConfig } from "@/config/site.config";
import { finalCtaContent } from "@/data/content";
import FinalCtaSection from "@/components/react/FinalCtaSection";
---

<FinalCtaSection
  client:visible
  title={finalCtaContent.title}
  description={finalCtaContent.description}
  cta={finalCtaContent.cta}
  ctaHref={siteConfig.links.postular}
  image={finalCtaContent.image}
  imageAlt={finalCtaContent.imageAlt}
/>
