---
import { insightContent } from "@/data/content";
---

<section class="mx-auto mt-6 w-full max-w-[1440px] px-4 md:mt-8 md:px-10" aria-labelledby="insight-title">
  <div class="relative overflow-hidden rounded-section bg-primary px-5 py-10 md:px-16 md:py-16 lg:px-24">
    <img
      src={insightContent.decorTop}
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute -right-8 -top-16 w-[220px] opacity-80 md:right-8 md:top-[-40px] md:w-[320px]"
    />
    <img
      src={insightContent.decorBottom}
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute -bottom-10 right-0 w-[180px] opacity-70 md:bottom-[-20px] md:right-24 md:w-[240px]"
    />

    <div class="relative z-10 grid gap-8 md:grid-cols-2 md:gap-12 lg:gap-16">
      <h2 id="insight-title" class="section-title max-w-[520px]">
        Hoy una buena formación académica{" "}
        <span class="font-semibold">{insightContent.titleAccent}</span>
      </h2>
      <p class="section-body max-w-[480px] self-center">
        {insightContent.bodyBefore}{" "}
        <strong class="font-medium">{insightContent.bodyBold}</strong>{" "}
        {insightContent.bodyAfter}
      </p>
    </div>
  </div>
</section>
